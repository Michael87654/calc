+    // BEGIN: масштаб таблицы и именованные сохранения (отдельные дополнения)
+    // Новые настройки и слоты не входят в state и в формат проекта.
+    const tableScaleStorageKey = "physcalc_table_scale";
+    const namedProjectPrefix = "physcalc_saved_";
+    let tableScalePercent = 100;
+
+    function applyTableScale(percent, persist = true) {
+      tableScalePercent = Math.max(70, Math.min(200, Math.round(percent / 10) * 10));
+      const surface = $("table-scroll");
+      surface.classList.toggle("table-scale-surface", tableScalePercent !== 100);
+      if (tableScalePercent === 100) surface.style.removeProperty("--table-scale");
+      else surface.style.setProperty("--table-scale", String(tableScalePercent / 100));
+      $("table-scale-percent").textContent = `${tableScalePercent}%`;
+      $("table-scale-minus-btn").disabled = tableScalePercent === 70;
+      $("table-scale-plus-btn").disabled = tableScalePercent === 200;
+      if (persist) {
+        try { localStorage.setItem(tableScaleStorageKey, String(tableScalePercent)); }
+        catch (error) { showToast("Масштаб изменён, но браузер не разрешил сохранить его."); }
+      }
+    }
+
+    function restoreTableScale() {
+      let percent = 100;
+      try {
+        const saved = Number(localStorage.getItem(tableScaleStorageKey));
+        if (Number.isInteger(saved) && saved >= 70 && saved <= 200 && saved % 10 === 0) percent = saved;
+      } catch (error) { /* При недоступном хранилище остаётся 100%. */ }
+      applyTableScale(percent, false);
+    }
+
+    function saveNamedProject() {
+      const answer = window.prompt("Имя сохранения проекта:", state.project.title || "Новый проект");
+      if (answer === null) return;
+      const name = answer.trim();
+      if (!name) { showToast("Введите непустое имя сохранения."); return; }
+      flushChanges();
+      try {
+        let timestamp = Date.now();
+        // Два быстрых сохранения не должны перезаписать друг друга.
+        while (localStorage.getItem(namedProjectPrefix + timestamp) !== null) timestamp += 1;
+        const slot = { name, savedAt: new Date().toISOString(), project: cloneProject(state.project) };
+        localStorage.setItem(namedProjectPrefix + timestamp, JSON.stringify(slot));
+        showToast(`Проект «${name}» сохранён отдельным слотом.`);
+      } catch (error) { showToast(`Не удалось сохранить проект: ${error.message}`); }
+    }
+
+    function readNamedProjects() {
+      const slots = [];
+      for (let index = 0; index < localStorage.length; index += 1) {
+        const key = localStorage.key(index);
+        if (!key || !/^physcalc_saved_\d+$/.test(key)) continue;
+        try {
+          const slot = JSON.parse(localStorage.getItem(key));
+          if (!slot || typeof slot.name !== "string" || !slot.project) throw new Error("Неверный слот.");
+          const time = Date.parse(slot.savedAt);
+          slots.push({ key, name: slot.name, savedAt: slot.savedAt, time: Number.isFinite(time) ? time : 0, invalid: false });
+        } catch (error) {
+          // Повреждённый слот можно удалить, не затрагивая остальные проекты.
+          slots.push({ key, name: "Повреждённое сохранение", time: 0, invalid: true });
+        }
+      }
+      return slots.sort((first, second) => second.time - first.time || Number(second.key.slice(namedProjectPrefix.length)) - Number(first.key.slice(namedProjectPrefix.length)));
+    }
+
+    function renderNamedProjects() {
+      const slots = readNamedProjects();
+      $("named-projects-list").innerHTML = slots.length ? slots.map(slot => {
+        const date = slot.time ? new Date(slot.time).toLocaleString("ru-RU") : "Дата неизвестна";
+        return `<div class="named-project-row"><div class="named-project-info"><strong>${escapeHTML(slot.name)}</strong><span class="named-project-date">${escapeHTML(date)}</span></div><div class="named-project-actions"><button class="small" type="button" data-open-named="${slot.key}"${slot.invalid ? " disabled" : ""}>Открыть</button><button class="small danger" type="button" data-delete-named="${slot.key}">Удалить</button></div></div>`;
+      }).join("") : '<p class="named-projects-empty">Нет сохранённых проектов</p>';
+    }
+
+    function showNamedProjects() {
+      try {
+        renderNamedProjects();
+        $("named-projects-dialog").showModal();
+      } catch (error) { showToast(`Не удалось открыть список сохранений: ${error.message}`); }
+    }
+
+    function openNamedProject(key) {
+      try {
+        const text = localStorage.getItem(key);
+        if (text === null) { renderNamedProjects(); showToast("Это сохранение уже удалено."); return; }
+        const slot = JSON.parse(text);
+        const project = validateProject(slot.project);
+        replaceProject(project, `Открыт проект «${slot.name}».`);
+        $("named-projects-dialog").close();
+      } catch (error) { showToast(`Не удалось открыть проект: ${error.message}`); }
+    }
+
+    function deleteNamedProject(key) {
+      try {
+        let name = "Повреждённое сохранение";
+        try { name = JSON.parse(localStorage.getItem(key))?.name || name; }
+        catch (error) { /* Для повреждённого JSON остаётся поясняющее имя. */ }
+        if (!window.confirm(`Удалить сохранение «${name}»?`)) return;
+        localStorage.removeItem(key);
+        renderNamedProjects();
+        showToast("Именованное сохранение удалено.");
+      } catch (error) { showToast(`Не удалось удалить сохранение: ${error.message}`); }
+    }
+
+    function initializeProjectViewTools() {
+      restoreTableScale();
+      $("table-scale-minus-btn").addEventListener("click", () => applyTableScale(tableScalePercent - 10));
+      $("table-scale-plus-btn").addEventListener("click", () => applyTableScale(tableScalePercent + 10));
+      $("save-as-btn").addEventListener("click", saveNamedProject);
+      $("open-named-btn").addEventListener("click", showNamedProjects);
+      $("close-named-projects-btn").addEventListener("click", () => $("named-projects-dialog").close());
+      $("named-projects-list").addEventListener("click", event => {
+        const openButton = event.target.closest("[data-open-named]");
+        const deleteButton = event.target.closest("[data-delete-named]");
+        if (openButton) openNamedProject(openButton.dataset.openNamed);
+        else if (deleteButton) deleteNamedProject(deleteButton.dataset.deleteNamed);
+      });
+    }
+
+    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initializeProjectViewTools, { once: true });
+    else initializeProjectViewTools();
+    // END: масштаб таблицы и именованные сохранения (отдельные дополнения)
   })();
   
